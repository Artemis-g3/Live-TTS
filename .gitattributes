# Normalize line endings for text files
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files must never be modified by Git
*.wav binary
*.mp3 binary
*.m4a binary
*.flac binary
*.ogg binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pt binary
*.pth binary
*.safetensors binary
*.exe binary
*.pyz binary
*.pkg binary
*.zip binary
